pipeline {
    agent any
    
    environment {
        // Configuration Mobile Flutter
        FLUTTER_VERSION = '3.24.0'
        FLUTTER_HOME = '/opt/flutter'
        PATH = "$FLUTTER_HOME/bin:$PATH"
        ANDROID_HOME = '/opt/android-sdk'
        ANDROID_SDK_ROOT = '/opt/android-sdk'
        APP_PATH = 'app'
        
        // Configuration des credentials Jenkins
        GOOGLE_PLAY_SERVICE_ACCOUNT = credentials('google-play-service-account')
        ANDROID_KEYSTORE = credentials('android-keystore')
        ANDROID_KEY_PROPERTIES = credentials('android-key-properties')
    }
    
    parameters {
        choice(
            name: 'DEPLOYMENT_TRACK',
            choices: ['internal', 'alpha', 'beta', 'production'],
            description: 'Choisissez le track de déploiement'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Ignorer les tests'
        )
        booleanParam(
            name: 'CLEAN_BUILD',
            defaultValue: true,
            description: 'Nettoyage avant build'
        )
    }
    
    stages {
        stage('🔧 Préparation') {
            steps {
                echo "🚀 Déploiement Mobile Jack Pot - Track: ${params.DEPLOYMENT_TRACK}"
                
                // Vérification des outils
                sh '''
                    echo "📋 Vérification des outils..."
                    flutter --version
                    dart --version
                    java -version
                '''
                
                // Nettoyage du workspace
                cleanWs()
                
                // Checkout du code
                checkout scm
                
                // Configuration des credentials
                sh '''
                    cd $APP_PATH
                    
                    # Copie du fichier de service Google Play Store
                    cp $GOOGLE_PLAY_SERVICE_ACCOUNT fastlane/google-play-service-account.json
                    
                    # Configuration des clés Android
                    cp $ANDROID_KEY_PROPERTIES android/key.properties
                    cp $ANDROID_KEYSTORE android/app/upload-keystore.jks
                '''
            }
        }
        
        stage('📦 Installation des dépendances') {
            steps {
                echo '📦 Installation des dépendances...'
                
                dir(APP_PATH) {
                    sh '''
                        # Installation des dépendances Flutter
                        flutter pub get
                        
                        # Installation des dépendances Fastlane
                        cd fastlane
                        bundle install
                    '''
                }
            }
        }
        
        stage('🧪 Tests') {
            when {
                not { params.SKIP_TESTS }
            }
            steps {
                echo '🧪 Exécution des tests...'
                
                dir(APP_PATH) {
                    sh '''
                        # Tests Flutter
                        flutter test
                        
                        # Analyse du code
                        flutter analyze
                        
                        # Tests Fastlane
                        cd fastlane
                        bundle exec fastlane test
                    '''
                }
            }
        }
        
        stage('🔨 Build') {
            steps {
                echo '🔨 Construction de l\'application...'
                
                dir(APP_PATH) {
                    script {
                        if (params.CLEAN_BUILD) {
                            sh 'flutter clean'
                        }
                        
                        sh '''
                            # Build de l'application
                            cd fastlane
                            bundle exec fastlane build_app_bundle
                        '''
                    }
                }
            }
        }
        
        stage('🚀 Déploiement') {
            steps {
                echo "🚀 Déploiement sur ${params.DEPLOYMENT_TRACK}..."
                
                dir(APP_PATH) {
                    script {
                        def deploymentLane = "deploy_${params.DEPLOYMENT_TRACK}"
                        
                        sh """
                            cd fastlane
                            bundle exec fastlane ${deploymentLane}
                        """
                    }
                }
            }
        }
        
        stage('📝 Archivage') {
            steps {
                echo '📝 Archivage des artefacts...'
                
                dir(APP_PATH) {
                    // Archivage des fichiers de build
                    archiveArtifacts artifacts: 'build/app/outputs/**/*.apk', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'build/app/outputs/**/*.aab', allowEmptyArchive: true
                    
                    // Archivage des rapports
                    publishTestResults testResultsPattern: 'test-results.xml'
                }
            }
        }
    }
    
    post {
        always {
            echo '🧹 Nettoyage...'
            
            dir(APP_PATH) {
                // Nettoyage des fichiers sensibles
                sh '''
                    rm -f fastlane/google-play-service-account.json
                    rm -f android/key.properties
                    rm -f android/app/upload-keystore.jks
                '''
            }
        }
        
        success {
            echo "✅ Déploiement mobile réussi sur ${params.DEPLOYMENT_TRACK} ! 🎉"
        }
        
        failure {
            echo "❌ Échec du déploiement mobile sur ${params.DEPLOYMENT_TRACK} 💥"
        }
        
        unstable {
            echo "⚠️ Build instable"
        }
    }
} 